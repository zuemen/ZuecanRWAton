-- | The book of record: the register that ties units outstanding to the
--   reserves the custodian attests to, the units themselves, and every way
--   units can move.
--
--   Every unit contract (a holding, or units in escrow) is signed by the
--   transfer agent (registrar), the custodian and the owner. So:
--
--   * no unit can exist without the custodian's signature, and the custodian
--     only signs inside the register's issuance (or when units already
--     covered by the register move). The transfer agent cannot create units
--     for itself, or for anyone, outside the register;
--   * the registrar cannot take units away without a choice the owner agreed
--     to by holding the contract;
--   * every path that delivers units to a new owner checks the receiver's
--     credential against the fund's eligibility rules.
--
--   Units leaving a holding go into an escrow contract (a transfer offer, a
--   sell order, a redemption request) signed by the same parties, so they
--   cannot be spent twice while the counterparty decides.
module Zuecan.Registry
  ( FundStatus (..)
  , FundRegister (..)
  , RegisterProposal (..)
  , ReserveAttestation (..)
  , FundHolding (..)
  , TransferOffer (..)
  , SellOrder (..)
  , MatchedTrade (..)
  , RedemptionRequest (..)
  , RedemptionPayout (..)
  , EnforcementRecord (..)
  , AcceptAppointment (..)
  , Attest (..)
  , RecordIssuance (..)
  , RecordRedemption (..)
  , SetStatus (..)
  , SplitUnits (..)
  , MergeUnits (..)
  , OfferTransfer (..)
  , ListForSale (..)
  , RequestRedemption (..)
  , Freeze (..)
  , Unfreeze (..)
  , Seize (..)
  , AcceptTransfer (..)
  , DeclineTransfer (..)
  , WithdrawTransfer (..)
  , Take (..)
  , CancelOrder (..)
  , Settle (..)
  , Unwind (..)
  , Abort (..)
  , ApproveRedemption (..)
  , RejectRedemption (..)
  , CancelRedemption (..)
  , Pay (..)
  , CancelPayout (..)
  , ReclaimUnits (..)
  , RecallOffer (..)
  , RecallOrder (..)
  , RecallTrade (..)
  , RecallRedemption (..)
  , RecallPayout (..)
  , liability
  , coverage
  , settlementDeadline
  ) where

import DA.Date (toDateUTC)
import DA.Text (intercalate)
import DA.Time
import qualified Zuecan.Cash as Cash
import Zuecan.Compliance (InvestorCredential, checkEligible, checkScreened)
import Zuecan.Fund
import Zuecan.Market
import Zuecan.Portfolio
import Zuecan.Types

data FundStatus
  = Open                    -- ^ subscriptions and redemptions
  | SubscriptionsSuspended  -- ^ redemptions only
  | Suspended               -- ^ neither (e.g. pending a NAV correction)
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- The register
-- ---------------------------------------------------------------------------

-- | The transfer agent appoints the custodian; the register only exists once
--   the custodian accepts.
template RegisterProposal
  with
    instrument : InstrumentId
    custodian : Party
    regulator : Party
    readers : [Party]
  where
    signatory instrument.registrar
    observer custodian

    choice AcceptAppointment : ContractId FundRegister
      controller custodian
      do
        now <- getTime
        create FundRegister with
          instrument, custodian, regulator, readers
          outstanding = 0.0
          attestedReserve = 0.0
          attestedAt = now
          attestationSeq = 0
          statementRef = "appointment"
          portfolioBreaches = []
          netFlowSinceAttestation = 0.0
          status = Open

-- | The custodian's statement of what it holds for the fund, with the
--   position list and the money-market limits measured against it. Kept as
--   a public history (proof of reserves).
template ReserveAttestation
  with
    instrument : InstrumentId
    custodian : Party
    readers : [Party]
    positions : [Position]
    metrics : PortfolioMetrics
    portfolioBreaches : [Text]
    attestedAt : Time
    seq : Int
    statementRef : Text
  where
    signatory custodian
    observer instrument.registrar, readers

-- | The register of record. Every issuance and redemption goes through it, so
--   `outstanding` is the authoritative unit count, and the coverage check
--   runs on every issuance.
--
--   It is under dual control: signed by both the transfer agent and the
--   custodian, so neither can archive it and start a new one with a different
--   unit count or reserve figure on its own.
--
--   `netFlowSinceAttestation` is the cash that came in (subscriptions) or
--   went out (redemptions) on-ledger since the custodian's last statement; the
--   custodian resets it to zero when it attests, because its new statement
--   already includes that cash.
template FundRegister
  with
    instrument : InstrumentId
    custodian : Party
    regulator : Party
    readers : [Party]
    outstanding : Decimal
    attestedReserve : Decimal
    attestedAt : Time
    attestationSeq : Int
    statementRef : Text
    portfolioBreaches : [Text]  -- ^ limits the last statement's portfolio breaks
    netFlowSinceAttestation : Decimal
    status : FundStatus
  where
    signatory instrument.registrar, custodian
    observer regulator, readers
    ensure outstanding >= 0.0 && attestedReserve >= 0.0

    -- | The custodian reports the fund's positions. The reserve figure is
    --   their total market value, so it cannot disagree with the positions.
    --   A portfolio that breaks the fund's limits is still recorded (hiding
    --   it would be worse) but stops new subscriptions until it is fixed.
    choice Attest : (ContractId FundRegister, ContractId ReserveAttestation)
      with
        positions : [Position]
        newStatementRef : Text
        termsCid : ContractId FundTerms
      controller custodian
      do
        assertMsg "a statement reference is required" (newStatementRef /= "")
        terms <- fetch termsCid
        checkTermsFor instrument terms
        now <- getTime
        let metrics = measure (toDateUTC now) positions
            found = breaches terms.portfolioRules positions metrics
            seq' = attestationSeq + 1
        record <- create ReserveAttestation with
          instrument, custodian, readers, positions, metrics
          portfolioBreaches = found
          attestedAt = now
          seq = seq'
          statementRef = newStatementRef
        register <- create this with
          attestedReserve = metrics.value
          attestedAt = now
          attestationSeq = seq'
          statementRef = newStatementRef
          portfolioBreaches = found
          netFlowSinceAttestation = 0.0
        pure (register, record)

    -- | The only way units come into existence. It needs the subscriber's
    --   authority as well as the transfer agent's, and runs with the
    --   custodian's as a signatory of the register, so it can create the
    --   holding itself; it consumes the subscriber's cash lock, so the cash it
    --   counts is real and counted once; and it prices the units itself, so
    --   the caller cannot choose how many.
    choice RecordIssuance : (ContractId FundRegister, ContractId FundHolding, ContractId Cash.CashHolding)
      with
        subscriber : Party
        lockedCashCid : ContractId Cash.LockedCash
        credentialCid : ContractId InvestorCredential
        termsCid : ContractId FundTerms
        navCid : ContractId NavReport
      controller instrument.registrar, subscriber
      do
        now <- getTime
        terms <- fetch termsCid
        checkTermsFor instrument terms
        assertMsg "the register's custodian is not the fund's custodian" (terms.custodian == custodian)
        assertMsg "the register's regulator is not the fund's regulator" (terms.regulator == regulator)
        nav <- fetch navCid
        checkNav terms now nav
        cred <- fetch credentialCid
        checkEligible terms.compliance subscriber terms.eligibility now cred
        assertMsg "the fund is not open for subscriptions" (status == Open)
        assertMsg "the custodian's reserve attestation is out of date"
          (isWithin terms.maxAttestationAge now attestedAt)
        assertMsg ("the portfolio breaches the fund's limits: " <> intercalate "; " portfolioBreaches)
          (null portfolioBreaches)
        lc <- fetch lockedCashCid
        assertMsg "the escrowed cash is not the subscriber's, held for this fund's custodian in its settlement asset"
          (lc.owner == subscriber && lc.lockedTo == instrument.registrar && lc.payee == custodian
            && lc.issuer == terms.cashIssuer && lc.currency == terms.currency)
        assertMsg "below the fund's minimum subscription" (lc.amount >= terms.minSubscription)
        let units = floor6 (lc.amount / nav.navPerUnit)
        assertMsg "the subscription buys less than one millionth of a unit" (units > 0.0)
        let next = this with
              outstanding = outstanding + units
              netFlowSinceAttestation = netFlowSinceAttestation + lc.amount
        assertMsg "issuance would leave units not fully backed by attested reserves"
          (liability next nav.navPerUnit <= coverage next)
        custodyCash <- exercise lockedCashCid Cash.PayOut
        register <- create next
        holding <- create FundHolding with
          instrument, custodian, owner = subscriber, units, frozen = False, regulator
        pure (register, holding, custodyCash)

    -- | Retire units against a payment. Needs both the transfer agent and the
    --   custodian, who is the one paying (RedemptionPayout.Pay).
    choice RecordRedemption : ContractId FundRegister
      with
        units : Decimal
        cashOut : Decimal
        termsCid : ContractId FundTerms
        navCid : ContractId NavReport
      controller instrument.registrar, custodian
      do
        now <- getTime
        terms <- fetch termsCid
        checkTermsFor instrument terms
        nav <- fetch navCid
        checkNav terms now nav
        assertMsg "the fund is suspended" (status /= Suspended)
        assertMsg "the custodian's reserve attestation is out of date"
          (isWithin terms.maxAttestationAge now attestedAt)
        assertMsg "cannot redeem more units than are outstanding" (units > 0.0 && units <= outstanding)
        assertMsg "a redemption must pay out cash" (cashOut > 0.0)
        -- Paying redeemers at NAV out of a reserve that no longer covers
        -- everyone favours whoever leaves first. Stop and reprice instead.
        assertMsg "reserves are below liabilities at NAV; redemptions wait for the NAV agent and custodian to reconcile"
          (liability this nav.navPerUnit <= coverage this)
        create this with
          outstanding = outstanding - units
          netFlowSinceAttestation = netFlowSinceAttestation - cashOut

    choice SetStatus : ContractId FundRegister
      with
        newStatus : FundStatus
      controller instrument.registrar
      do create this with status = newStatus

-- | Units outstanding valued at `navPerUnit`.
liability : FundRegister -> Decimal -> Decimal
liability register navPerUnit = register.outstanding * navPerUnit

-- | What backs the units: the last attested reserve plus on-ledger flows since.
coverage : FundRegister -> Decimal
coverage register = register.attestedReserve + register.netFlowSinceAttestation

-- ---------------------------------------------------------------------------
-- Units
-- ---------------------------------------------------------------------------

template FundHolding
  with
    instrument : InstrumentId
    custodian : Party
    owner : Party
    units : Decimal
    frozen : Bool
    regulator : Party
  where
    signatory instrument.registrar, custodian, owner
    observer regulator
    ensure units > 0.0 && units == floor6 units

    choice SplitUnits : (ContractId FundHolding, ContractId FundHolding)
      with
        amount : Decimal
      controller owner
      do
        assertMsg "the holding is frozen" (not frozen)
        assertMsg "split amount must be strictly between zero and the holding" (amount > 0.0 && amount < units)
        a <- create this with units = amount
        b <- create this with units = units - amount
        pure (a, b)

    choice MergeUnits : ContractId FundHolding
      with
        otherCid : ContractId FundHolding
      controller owner
      do
        other <- fetch otherCid
        assertMsg "can only merge holdings of the same instrument and owner"
          (other.instrument == instrument && other.custodian == custodian
            && other.owner == owner && other.regulator == regulator)
        assertMsg "the holding is frozen" (not frozen && not other.frozen)
        archive otherCid
        create this with units = units + other.units

    -- | Offer units to another investor off-venue (a gift, an internal
    --   reallocation). The receiver must accept and pass eligibility.
    choice OfferTransfer : (ContractId TransferOffer, Optional (ContractId FundHolding))
      with
        receiver : Party
        amount : Decimal
        termsCid : ContractId FundTerms
        credentialCid : ContractId InvestorCredential
      controller owner
      do
        -- A sanctioned holder must not be able to move units away from a
        -- freeze by gifting them.
        now <- getTime
        terms <- fetch termsCid
        checkTermsFor instrument terms
        cred <- fetch credentialCid
        checkScreened terms.compliance owner terms.eligibility now cred
        rest <- carveOut this amount
        offer <- create TransferOffer with
          instrument, custodian, sender = owner, receiver, units = amount, regulator
        pure (offer, rest)

    -- | Quote units to one buyer (the request-for-quote reply) at `price` per
    --   unit until `expiresAt`. The venue then has `settleWithin` to settle.
    choice ListForSale : (ContractId SellOrder, Optional (ContractId FundHolding))
      with
        buyer : Party
        operator : Party
        amount : Decimal
        price : Decimal
        cashIssuer : Party
        currency : Text
        expiresAt : Time
        settleWithin : RelTime
      controller owner
      do
        assertMsg "price must be positive" (price > 0.0)
        assertMsg "the settlement window must be positive" (settleWithin > seconds 0)
        assertMsg "cannot sell to yourself" (buyer /= owner)
        rest <- carveOut this amount
        order <- create SellOrder with
          instrument, custodian, seller = owner, buyer, operator, regulator
          units = amount, price, cashIssuer, currency, expiresAt, settleWithin
        pure (order, rest)

    choice RequestRedemption : (ContractId RedemptionRequest, Optional (ContractId FundHolding))
      with
        amount : Decimal
      controller owner
      do
        now <- getTime
        rest <- carveOut this amount
        request <- create RedemptionRequest with
          instrument, custodian, investor = owner, regulator, units = amount, requestedAt = now
        pure (request, rest)

    -- | Legal or regulatory hold. A frozen holding cannot be split, merged,
    --   offered, listed or redeemed.
    choice Freeze : ContractId FundHolding
      with
        reason : Text
      controller instrument.registrar
      do
        _ <- recordEnforcement this "freeze" reason
        create this with frozen = True

    choice Unfreeze : ContractId FundHolding
      with
        reason : Text
      controller instrument.registrar
      do
        _ <- recordEnforcement this "unfreeze" reason
        create this with frozen = False

    -- | Move the units to the registrar's own account under a court or
    --   regulatory order (the transfer agent's recovery power).
    choice Seize : ContractId FundHolding
      with
        legalOrderRef : Text
      controller instrument.registrar
      do
        assertMsg "a legal order reference is required" (legalOrderRef /= "")
        _ <- recordEnforcement this "seize" legalOrderRef
        create this with owner = instrument.registrar, frozen = True

template TransferOffer
  with
    instrument : InstrumentId
    custodian : Party
    sender : Party
    receiver : Party
    units : Decimal
    regulator : Party
  where
    signatory instrument.registrar, custodian, sender
    observer receiver, regulator

    choice AcceptTransfer : ContractId FundHolding
      with
        termsCid : ContractId FundTerms
        credentialCid : ContractId InvestorCredential
      controller receiver
      do
        now <- getTime
        terms <- fetch termsCid
        checkTermsFor instrument terms
        cred <- fetch credentialCid
        checkEligible terms.compliance receiver terms.eligibility now cred
        deliver instrument custodian receiver units regulator

    choice DeclineTransfer : ContractId FundHolding
      controller receiver
      do deliver instrument custodian sender units regulator

    choice WithdrawTransfer : ContractId FundHolding
      controller sender
      do deliver instrument custodian sender units regulator

    -- | Legal hold on units in escrow: they go back to sender as a frozen
    --   holding, so parking units in an escrow does not put them out of reach
    --   of a freeze or seizure.
    choice RecallOffer : ContractId FundHolding
      with
        legalOrderRef : Text
      controller instrument.registrar
      do
        assertMsg "a legal order reference is required" (legalOrderRef /= "")
        _ <- recordEnforcementOf instrument.registrar sender regulator "recall" legalOrderRef units
        deliverFrozen instrument custodian sender units regulator

-- | A firm quote to one buyer. Taking it requires the buyer to have locked
--   exactly the notional for the venue to pay the seller.
template SellOrder
  with
    instrument : InstrumentId
    custodian : Party
    seller : Party
    buyer : Party
    operator : Party
    regulator : Party
    units : Decimal
    price : Decimal
    cashIssuer : Party
    currency : Text
    expiresAt : Time
    settleWithin : RelTime
  where
    signatory instrument.registrar, custodian, seller
    observer buyer, operator, regulator

    choice Take : ContractId MatchedTrade
      with
        lockedCashCid : ContractId Cash.LockedCash
      controller buyer
      do
        now <- getTime
        assertMsg "the order has expired" (now < expiresAt)
        lc <- fetch lockedCashCid
        let notional = floor6 (units * price)
            deadline = settlementDeadline this
        assertMsg "locked cash does not match the order"
          (lc.owner == buyer && lc.lockedTo == operator && lc.payee == seller
            && lc.issuer == cashIssuer && lc.currency == currency && lc.amount == notional)
        -- The lock must lapse exactly when the venue's time to settle does:
        -- earlier and the buyer could pull the cash mid-settlement, later and
        -- the venue could still pay the seller after the trade was aborted.
        assertMsg "the cash lock must lapse exactly at the settlement deadline" (lc.releaseAfter == deadline)
        -- Pledge the lock to this trade so it cannot back another one too.
        committedCid <- exercise lockedCashCid Cash.Commit
        create MatchedTrade with
          instrument, custodian, seller, buyer, operator, regulator, units, price
          cashIssuer, currency, lockedCashCid = committedCid, matchedAt = now, deadline

    choice CancelOrder : ContractId FundHolding
      controller seller
      do deliver instrument custodian seller units regulator

    -- | Legal hold on units in escrow: they go back to seller as a frozen
    --   holding, so parking units in an escrow does not put them out of reach
    --   of a freeze or seizure.
    choice RecallOrder : ContractId FundHolding
      with
        legalOrderRef : Text
      controller instrument.registrar
      do
        assertMsg "a legal order reference is required" (legalOrderRef /= "")
        _ <- recordEnforcementOf instrument.registrar seller regulator "recall" legalOrderRef units
        deliverFrozen instrument custodian seller units regulator

-- | Both sides committed; the venue settles delivery-versus-payment in one
--   transaction or unwinds. If it does neither by `deadline`, either
--   counterparty can walk away.
template MatchedTrade
  with
    instrument : InstrumentId
    custodian : Party
    seller : Party
    buyer : Party
    operator : Party
    regulator : Party
    units : Decimal
    price : Decimal
    cashIssuer : Party
    currency : Text
    lockedCashCid : ContractId Cash.LockedCash
    matchedAt : Time
    deadline : Time
  where
    signatory instrument.registrar, custodian, seller, buyer
    observer operator, regulator

    choice Settle : (ContractId FundHolding, ContractId Cash.CashHolding, ContractId TradePrint)
      with
        marketCid : ContractId MarketControl
        termsCid : ContractId FundTerms
        navCid : ContractId NavReport
        buyerCredentialCid : ContractId InvestorCredential
        sellerCredentialCid : ContractId InvestorCredential
      controller operator
      do
        now <- getTime
        assertMsg "the settlement deadline has passed" (now < deadline)
        market <- fetch marketCid
        assertMsg "market control is for another venue or instrument"
          (market.operator == operator && market.instrument == instrument)
        assertMsg "the market control is not co-signed by the fund's regulator" (market.regulator == regulator)
        assertMsg ("the market is not trading: " <> show market.status) (market.status == Trading)
        assertMsg "the trade exceeds the venue's per-trade size cap" (units <= market.maxTradeUnits)
        terms <- fetch termsCid
        checkTermsFor instrument terms
        assertMsg "this venue is not the fund's approved venue" (terms.operator == operator)
        assertMsg "the regulator on the trade is not the fund's regulator" (terms.regulator == regulator)
        assertMsg "settlement cash is not the fund's settlement asset"
          (terms.cashIssuer == cashIssuer && terms.currency == currency)
        nav <- fetch navCid
        checkNav terms now nav
        assertMsg "the price is outside the venue's band around NAV"
          (bpsDeviation nav.navPerUnit price <= market.maxDeviationBps)
        buyerCred <- fetch buyerCredentialCid
        checkEligible terms.compliance buyer terms.eligibility now buyerCred
        -- Paying a seller who has since been sanctioned is itself a violation.
        sellerCred <- fetch sellerCredentialCid
        checkScreened terms.compliance seller terms.eligibility now sellerCred
        paid <- exercise lockedCashCid Cash.PayOut
        delivered <- deliver instrument custodian buyer units regulator
        tradePrint <- create TradePrint with
          operator, instrument, readers = [terms.publicParty, regulator]
          units, price, currency, navAtExecution = nav.navPerUnit, executedAt = now
        _ <- create RegulatoryTradeReport with
          operator, regulator, instrument, seller, buyer, units, price, currency, executedAt = now
        pure (delivered, paid, tradePrint)

    choice Unwind : (ContractId FundHolding, ContractId Cash.CashHolding)
      with
        reason : Text
      controller operator
      do
        refund <- exercise lockedCashCid Cash.Release
        restored <- deliver instrument custodian seller units regulator
        pure (restored, refund)

    -- | The seller takes the units back once the venue's time is up. The
    --   buyer's cash lock lapses at the same moment, so the buyer reclaims it
    --   with LockedCash.Reclaim.
    choice Abort : ContractId FundHolding
      with
        actor : Party
      controller actor
      do
        assertMsg "only a counterparty can abort" (actor == seller || actor == buyer)
        now <- getTime
        assertMsg "the venue still has until the deadline to settle" (now >= deadline)
        deliver instrument custodian seller units regulator

    -- | Legal hold on units in a matched trade: they go back to the seller as
    --   a frozen holding. The buyer's cash lock lapses at the deadline and is
    --   reclaimed with LockedCash.Reclaim.
    choice RecallTrade : ContractId FundHolding
      with
        legalOrderRef : Text
      controller instrument.registrar
      do
        assertMsg "a legal order reference is required" (legalOrderRef /= "")
        _ <- recordEnforcementOf instrument.registrar seller regulator "recall" legalOrderRef units
        deliverFrozen instrument custodian seller units regulator

template RedemptionRequest
  with
    instrument : InstrumentId
    custodian : Party
    investor : Party
    regulator : Party
    units : Decimal
    requestedAt : Time
  where
    signatory instrument.registrar, custodian, investor
    observer regulator

    -- | Forward pricing: units are redeemed at the NAV current when the
    --   transfer agent processes the request, not the one when it was made.
    choice ApproveRedemption : ContractId RedemptionPayout
      with
        termsCid : ContractId FundTerms
        navCid : ContractId NavReport
        credentialCid : ContractId InvestorCredential
      controller instrument.registrar
      do
        now <- getTime
        terms <- fetch termsCid
        checkTermsFor instrument terms
        nav <- fetch navCid
        checkNav terms now nav
        cred <- fetch credentialCid
        checkScreened terms.compliance investor terms.eligibility now cred
        assertMsg "below the fund's minimum redemption" (units >= terms.minRedemptionUnits)
        let cashAmount = floor6 (units * nav.navPerUnit)
        assertMsg "the redemption is worth less than one cent" (cashAmount >= 0.01)
        create RedemptionPayout with
          instrument, custodian, investor, regulator, units, cashAmount
          navPerUnit = nav.navPerUnit, navSeq = nav.seq, approvedAt = now
          payBy = addRelTime now terms.maxNavAge

    choice RejectRedemption : ContractId FundHolding
      with
        reason : Text
      controller instrument.registrar
      do deliver instrument custodian investor units regulator

    choice CancelRedemption : ContractId FundHolding
      controller investor
      do deliver instrument custodian investor units regulator

    -- | Legal hold on units in escrow: they go back to investor as a frozen
    --   holding, so parking units in an escrow does not put them out of reach
    --   of a freeze or seizure.
    choice RecallRedemption : ContractId FundHolding
      with
        legalOrderRef : Text
      controller instrument.registrar
      do
        assertMsg "a legal order reference is required" (legalOrderRef /= "")
        _ <- recordEnforcementOf instrument.registrar investor regulator "recall" legalOrderRef units
        deliverFrozen instrument custodian investor units regulator

-- | The transfer agent has struck the price; the custodian pays out of the
--   fund's cash and the units are retired in the same transaction.
template RedemptionPayout
  with
    instrument : InstrumentId
    custodian : Party
    investor : Party
    regulator : Party
    units : Decimal
    cashAmount : Decimal
    navPerUnit : Decimal
    navSeq : Int      -- ^ the NAV report the price was struck at
    approvedAt : Time
    payBy : Time      -- ^ after this the investor can take the units back
  where
    signatory instrument.registrar, custodian, investor
    observer regulator

    choice Pay : (ContractId Cash.CashHolding, ContractId FundRegister)
      with
        cashCid : ContractId Cash.CashHolding
        registerCid : ContractId FundRegister
        termsCid : ContractId FundTerms
        navCid : ContractId NavReport
        credentialCid : ContractId InvestorCredential
      controller custodian
      do
        now <- getTime
        assertMsg "the payout has lapsed; the investor can take the units back" (now < payBy)
        terms <- fetch termsCid
        checkTermsFor instrument terms
        -- Paying a price struck at a NAV that has since been replaced (say,
        -- marked down) would let an early redeemer leave at the old price
        -- and the remaining holders carry the loss.
        nav <- fetch navCid
        assertMsg "the payout was priced at a NAV that is no longer current; cancel and re-approve it"
          (nav.seq == navSeq && nav.navPerUnit == navPerUnit)
        -- The investor may have been sanctioned since approval.
        cred <- fetch credentialCid
        checkScreened terms.compliance investor terms.eligibility now cred
        cash <- fetch cashCid
        assertMsg "payment must be the custodian's own cash in the fund's settlement asset"
          (cash.owner == custodian && cash.issuer == terms.cashIssuer && cash.currency == terms.currency)
        (paid, _) <- exercise cashCid Cash.Transfer with newOwner = investor, transferAmount = cashAmount
        register <- exercise registerCid RecordRedemption with units, cashOut = cashAmount, termsCid, navCid
        pure (paid, register)

    choice CancelPayout : ContractId FundHolding
      with
        reason : Text
      controller instrument.registrar
      do deliver instrument custodian investor units regulator

    -- | The investor's exit when the custodian has not paid in time.
    choice ReclaimUnits : ContractId FundHolding
      controller investor
      do
        now <- getTime
        assertMsg "the custodian still has until payBy to pay" (now >= payBy)
        deliver instrument custodian investor units regulator

    -- | Legal hold on units in escrow: they go back to investor as a frozen
    --   holding, so parking units in an escrow does not put them out of reach
    --   of a freeze or seizure.
    choice RecallPayout : ContractId FundHolding
      with
        legalOrderRef : Text
      controller instrument.registrar
      do
        assertMsg "a legal order reference is required" (legalOrderRef /= "")
        _ <- recordEnforcementOf instrument.registrar investor regulator "recall" legalOrderRef units
        deliverFrozen instrument custodian investor units regulator

-- | Audit trail of freezes, unfreezes and seizures.
template EnforcementRecord
  with
    registrar : Party
    owner : Party
    regulator : Party
    action : Text
    reference : Text
    units : Decimal
    recordedAt : Time
  where
    signatory registrar
    observer owner, regulator

-- | When the venue must have settled a trade on `order`.
settlementDeadline : SellOrder -> Time
settlementDeadline order = addRelTime order.expiresAt order.settleWithin

-- | Take `amount` out of a holding for an escrow; returns what is left.
carveOut : FundHolding -> Decimal -> Update (Optional (ContractId FundHolding))
carveOut h amount = do
  assertMsg "the holding is frozen" (not h.frozen)
  assertMsg "amount must be positive and covered by the holding" (amount > 0.0 && amount <= h.units)
  assertMsg "amount has more than six decimal places" (amount == floor6 amount)
  if amount == h.units
    then pure None
    else Some <$> create h with units = h.units - amount

-- | Units back into a holding. Only ever called inside a choice whose
--   contract the custodian signed (an escrow of units already on the
--   register), which is what authorizes the custodian's signature here.
deliver : InstrumentId -> Party -> Party -> Decimal -> Party -> Update (ContractId FundHolding)
deliver instrument custodian owner units regulator =
  create FundHolding with instrument, custodian, owner, units, frozen = False, regulator

-- | Units back into a frozen holding, for a legal hold on units in escrow.
deliverFrozen : InstrumentId -> Party -> Party -> Decimal -> Party -> Update (ContractId FundHolding)
deliverFrozen instrument custodian owner units regulator =
  create FundHolding with instrument, custodian, owner, units, frozen = True, regulator

recordEnforcement : FundHolding -> Text -> Text -> Update (ContractId EnforcementRecord)
recordEnforcement h action reference =
  recordEnforcementOf h.instrument.registrar h.owner h.regulator action reference h.units

recordEnforcementOf : Party -> Party -> Party -> Text -> Text -> Decimal -> Update (ContractId EnforcementRecord)
recordEnforcementOf registrar owner regulator action reference units = do
  now <- getTime
  create EnforcementRecord with registrar, owner, regulator, action, reference, units, recordedAt = now
