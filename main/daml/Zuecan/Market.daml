-- | Controls of the permissioned secondary market. Trading is bilateral
--   (request-for-quote, then delivery-versus-payment) rather than through a
--   shared liquidity pool: on Canton every swap against a single pool
--   contract would archive and recreate it, so all traders would contend for
--   the same contract.
module Zuecan.Market
  ( MarketStatus (..)
  , MarketControl (..)
  , MarketProposal (..)
  , TradePrint (..)
  , RegulatoryTradeReport (..)
  , OperatorHalt (..)
  , OperatorResume (..)
  , RegulatorHalt (..)
  , RegulatorResume (..)
  , SetLimits (..)
  , RegulatorSetLimits (..)
  , AcceptMarket (..)
  , RejectMarket (..)
  ) where

import Zuecan.Types

data MarketStatus
  = Trading
  | HaltedByOperator with reason : Text
  | HaltedByRegulator with reason : Text
  deriving (Eq, Show)

-- | Venue-level switches for one instrument. Signed by the venue and the
--   regulator, so the venue cannot archive a halted control and trade under a
--   fresh one of its own. A halt the regulator imposes can only be lifted by
--   the regulator; the venue can tighten the price band and size cap on its
--   own, loosening them takes the regulator.
template MarketControl
  with
    operator : Party
    regulator : Party
    instrument : InstrumentId
    readers : [Party]
    status : MarketStatus
    maxTradeUnits : Decimal   -- ^ per-trade size cap
    maxDeviationBps : Decimal -- ^ price band around NAV
  where
    signatory operator, regulator
    observer instrument.registrar, readers
    ensure maxTradeUnits > 0.0 && maxDeviationBps >= 0.0

    choice OperatorHalt : ContractId MarketControl
      with
        reason : Text
      controller operator
      do
        case status of
          HaltedByRegulator _ -> abort "the regulator has halted this market"
          _ -> create this with status = HaltedByOperator reason

    choice OperatorResume : ContractId MarketControl
      controller operator
      do
        case status of
          HaltedByOperator _ -> create this with status = Trading
          HaltedByRegulator _ -> abort "only the regulator can lift a regulatory halt"
          Trading -> abort "the market is already trading"

    choice RegulatorHalt : ContractId MarketControl
      with
        reason : Text
      controller regulator
      do create this with status = HaltedByRegulator reason

    choice RegulatorResume : ContractId MarketControl
      controller regulator
      do
        case status of
          HaltedByRegulator _ -> create this with status = Trading
          _ -> abort "there is no regulatory halt to lift"

    -- | The venue may only tighten its limits on its own.
    choice SetLimits : ContractId MarketControl
      with
        newMaxTradeUnits : Decimal
        newMaxDeviationBps : Decimal
      controller operator
      do
        assertMsg "the venue can only tighten its limits; loosening them takes the regulator"
          (newMaxTradeUnits <= maxTradeUnits && newMaxDeviationBps <= maxDeviationBps)
        create this with maxTradeUnits = newMaxTradeUnits, maxDeviationBps = newMaxDeviationBps

    choice RegulatorSetLimits : ContractId MarketControl
      with
        newMaxTradeUnits : Decimal
        newMaxDeviationBps : Decimal
      controller regulator
      do create this with maxTradeUnits = newMaxTradeUnits, maxDeviationBps = newMaxDeviationBps

-- | The venue asks the regulator to approve its market for an instrument.
template MarketProposal
  with
    control : MarketControl
  where
    signatory control.operator
    observer control.regulator

    choice AcceptMarket : ContractId MarketControl
      controller control.regulator
      do create control

    choice RejectMarket : ()
      with
        reason : Text
      controller control.regulator
      do pure ()

-- | Public post-trade transparency: price and size, no identities.
template TradePrint
  with
    operator : Party
    instrument : InstrumentId
    readers : [Party]
    units : Decimal
    price : Decimal
    currency : Text
    navAtExecution : Decimal
    executedAt : Time
  where
    signatory operator
    observer readers

-- | The same trade with both counterparties, for the regulator only.
template RegulatoryTradeReport
  with
    operator : Party
    regulator : Party
    instrument : InstrumentId
    seller : Party
    buyer : Party
    units : Decimal
    price : Decimal
    currency : Text
    executedAt : Time
  where
    signatory operator
    observer regulator
