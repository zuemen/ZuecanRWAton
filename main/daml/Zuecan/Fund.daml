-- | The fund's terms and its daily NAV.
--
--   The instrument is a tokenized government money-market fund (short-term
--   US Treasury bills and Treasury repo). Units are accumulating: income is
--   reflected in a rising NAV rather than paid out, as in OUSG. The register
--   that ties units to reserves is in Zuecan.Registry.
module Zuecan.Fund
  ( FundTerms (..)
  , TermsProposal (..)
  , NavReport (..)
  , ApproveTerms (..)
  , RejectTerms (..)
  , WithdrawTerms (..)
  , Republish (..)
  , checkTermsFor
  , checkNav
  ) where

import DA.Time (RelTime)
import Zuecan.Compliance (Eligibility (..))
import Zuecan.Portfolio (PortfolioRules)
import Zuecan.Types

-- | The fund's offering terms. `offeringDocHash` commits to the off-ledger
--   prospectus or private placement memorandum.
--
--   Signed by the transfer agent and the regulator, so neither can change
--   them alone: the terms decide whose KYC credentials count, which venue
--   may settle trades, what the settlement asset is and which portfolio
--   limits apply. The transfer agent proposes (TermsProposal) and the
--   regulator approves; approving an amendment archives the version it
--   replaces, so every flow handed the old contract id fails from then on.
template FundTerms
  with
    instrument : InstrumentId
    name : Text
    strategy : Text
    currency : Text
    cashIssuer : Party       -- ^ the only settlement asset accepted
    custodian : Party        -- ^ holds the Treasury bills and the fund's cash
    navAgent : Party         -- ^ fund administrator that strikes the NAV
    compliance : Party       -- ^ KYC/AML agent whose credentials the fund accepts
    operator : Party         -- ^ secondary-market venue
    regulator : Party
    publicParty : Party      -- ^ read-only party for public disclosure
    eligibility : Eligibility
    portfolioRules : PortfolioRules  -- ^ limits the custodian's reported portfolio must meet
    minSubscription : Decimal     -- ^ in `currency`
    minRedemptionUnits : Decimal
    maxNavAge : RelTime
    maxAttestationAge : RelTime
    offeringDocHash : Text
    version : Int
  where
    signatory instrument.registrar, regulator
    observer custodian, navAgent, compliance, operator, publicParty
    ensure name /= "" && currency /= "" && offeringDocHash /= ""
      && minSubscription > 0.0 && minRedemptionUnits > 0.0
      && not (null eligibility.allowedClasses)
      && not (null eligibility.allowedJurisdictions)

-- | The transfer agent's proposal for a fund's first terms (`replaces` is
--   None) or for an amendment of the live version.
template TermsProposal
  with
    proposed : FundTerms
    replaces : Optional (ContractId FundTerms)
    rationale : Text
  where
    signatory proposed.instrument.registrar
    observer proposed.regulator

    choice ApproveTerms : ContractId FundTerms
      controller proposed.regulator
      do
        case replaces of
          None -> assertMsg "first terms must be version 1" (proposed.version == 1)
          Some currentCid -> do
            current <- fetch currentCid
            assertMsg "an amendment cannot change the instrument" (current.instrument == proposed.instrument)
            -- No check that the regulator stays the same is needed: archiving
            -- the current terms takes the current regulator's authority, and
            -- only the proposal's regulator is a controller here.
            assertMsg "an amendment must bump the version by one" (proposed.version == current.version + 1)
            archive currentCid
        create proposed

    choice RejectTerms : ()
      with
        reason : Text
      controller proposed.regulator
      do pure ()

    choice WithdrawTerms : ()
      controller proposed.instrument.registrar
      do pure ()

-- | The NAV per unit struck by the fund administrator. Republishing archives
--   the previous report, so only the latest one is ever live.
template NavReport
  with
    instrument : InstrumentId
    navAgent : Party
    readers : [Party]
    navPerUnit : Decimal
    asOf : Time
    seq : Int
    methodologyRef : Text
  where
    signatory navAgent
    observer instrument.registrar, readers
    ensure navPerUnit > 0.0 && methodologyRef /= ""

    choice Republish : ContractId NavReport
      with
        newNavPerUnit : Decimal
        newMethodologyRef : Text
      controller navAgent
      do
        now <- getTime
        create this with
          navPerUnit = newNavPerUnit
          asOf = now
          seq = seq + 1
          methodologyRef = newMethodologyRef

checkTermsFor : InstrumentId -> FundTerms -> Update ()
checkTermsFor instrument terms =
  assertMsg "terms are for a different instrument" (terms.instrument == instrument)

-- | The NAV is this fund's, from its NAV agent, and fresh.
checkNav : FundTerms -> Time -> NavReport -> Update ()
checkNav terms now nav = do
  assertMsg "NAV is for a different instrument" (nav.instrument == terms.instrument)
  assertMsg "NAV was not struck by the fund's NAV agent" (nav.navAgent == terms.navAgent)
  assertMsg "NAV is out of date" (isWithin terms.maxNavAge now nav.asOf)
