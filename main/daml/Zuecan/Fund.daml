-- | The fund's terms and its daily NAV.
--
--   The instrument is a tokenized government money-market fund (short-term
--   US Treasury bills and Treasury repo). Units are accumulating: income is
--   reflected in a rising NAV rather than paid out, as in OUSG. The register
--   that ties units to reserves is in Zuecan.Registry.
module Zuecan.Fund
  ( FundTerms (..)
  , NavReport (..)
  , Amend (..)
  , Republish (..)
  , checkTermsFor
  , checkNav
  ) where

import DA.Time (RelTime)
import Zuecan.Compliance (Eligibility (..))
import Zuecan.Portfolio (PortfolioRules)
import Zuecan.Types

-- | The fund's offering terms, signed by the transfer agent. `offeringDocHash`
--   commits to the off-ledger prospectus or private placement memorandum.
template FundTerms
  with
    instrument : InstrumentId
    name : Text
    strategy : Text
    currency : Text
    cashIssuer : Party       -- ^ the only settlement asset accepted
    custodian : Party        -- ^ holds the Treasury bills and the fund's cash
    navAgent : Party         -- ^ fund administrator that strikes the NAV
    compliance : Party       -- ^ KYC/AML agent whose credentials the fund accepts
    operator : Party         -- ^ secondary-market venue
    regulator : Party
    publicParty : Party      -- ^ read-only party for public disclosure
    eligibility : Eligibility
    portfolioRules : PortfolioRules  -- ^ limits the custodian's reported portfolio must meet
    minSubscription : Decimal     -- ^ in `currency`
    minRedemptionUnits : Decimal
    maxNavAge : RelTime
    maxAttestationAge : RelTime
    offeringDocHash : Text
    version : Int
  where
    signatory instrument.registrar
    observer custodian, navAgent, compliance, operator, regulator, publicParty
    ensure name /= "" && currency /= "" && offeringDocHash /= ""
      && minSubscription > 0.0 && minRedemptionUnits > 0.0
      && not (null eligibility.allowedClasses)
      && not (null eligibility.allowedJurisdictions)

    -- | A new version of the terms. Archiving the old one makes every flow
    --   that is handed the old contract id fail, so changes take effect at once.
    choice Amend : ContractId FundTerms
      with
        newTerms : FundTerms
      controller instrument.registrar
      do
        assertMsg "an amendment cannot change the instrument" (newTerms.instrument == instrument)
        assertMsg "an amendment must bump the version by one" (newTerms.version == version + 1)
        create newTerms

-- | The NAV per unit struck by the fund administrator. Republishing archives
--   the previous report, so only the latest one is ever live.
template NavReport
  with
    instrument : InstrumentId
    navAgent : Party
    readers : [Party]
    navPerUnit : Decimal
    asOf : Time
    seq : Int
    methodologyRef : Text
  where
    signatory navAgent
    observer instrument.registrar, readers
    ensure navPerUnit > 0.0 && methodologyRef /= ""

    choice Republish : ContractId NavReport
      with
        newNavPerUnit : Decimal
        newMethodologyRef : Text
      controller navAgent
      do
        now <- getTime
        create this with
          navPerUnit = newNavPerUnit
          asOf = now
          seq = seq + 1
          methodologyRef = newMethodologyRef

checkTermsFor : InstrumentId -> FundTerms -> Update ()
checkTermsFor instrument terms =
  assertMsg "terms are for a different instrument" (terms.instrument == instrument)

-- | The NAV is this fund's, from its NAV agent, and fresh.
checkNav : FundTerms -> Time -> NavReport -> Update ()
checkNav terms now nav = do
  assertMsg "NAV is for a different instrument" (nav.instrument == terms.instrument)
  assertMsg "NAV was not struck by the fund's NAV agent" (nav.navAgent == terms.navAgent)
  assertMsg "NAV is out of date" (isWithin terms.maxNavAge now nav.asOf)
